---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { interfaces as manifest, routeCount } from '../../data/botApi';
import { Shield, Route, Download } from 'lucide-astro';
---

<DocsLayout title="API Reference — Argon Bot API" current="/docs/">
  <div class="animate-fade-in-up">
    <h1 class="text-3xl font-bold tracking-tight mb-2">API Reference</h1>
    <p class="text-text-secondary mb-8">
      All Bot API interfaces with their routes, request/response types, and versioning status.
      Every request requires <code class="text-xs bg-oled-surface px-1.5 py-0.5 rounded font-mono">Authorization: Bot &lt;token&gt;</code> header.
    </p>

    <div class="mb-6 flex items-center gap-4 text-sm text-text-muted">
      <span>{manifest.length} interfaces</span>
      <span>·</span>
      <span>{routeCount} routes</span>
    </div>
  </div>

  <div class="glass rounded-2xl p-5 mb-8 animate-fade-in-up">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="min-w-0">
        <h2 class="text-lg font-semibold mb-1">OpenAPI specification</h2>
        <p class="text-sm text-text-secondary">
          The whole Bot API as a single OpenAPI 3.0 document, generated from the running routes.
          Feed it to <code class="text-xs bg-oled-surface px-1.5 py-0.5 rounded font-mono">openapi-generator</code>
          and get a typed client in your language instead of writing one.
        </p>
      </div>
      <a
        href="/openapi.json"
        download="argon-bot-api.openapi.json"
        class="shrink-0 inline-flex items-center gap-2 text-sm font-medium px-4 py-2 rounded-lg border border-accent/20 bg-accent-subtle text-accent hover:border-accent/40 transition-colors"
      >
        <Download class="size-4" />
        Download openapi.json
      </a>
    </div>

    <div class="code-block text-[12px] mt-4">
      <pre set:html={`<span class="text-text-muted">Always current, straight from the gateway:</span>
https://gateway.argon.zone/openapi.json

<span class="text-text-muted">Generate a client:</span>
<span class="text-accent-hover">openapi-generator-cli</span> generate <span class="text-text-secondary">-i</span> <span class="text-accent-2">openapi.json</span> <span class="text-text-secondary">-g</span> <span class="text-accent-2">python</span> <span class="text-text-secondary">-o</span> <span class="text-accent-2">./argon-bot</span>`} />
    </div>
  </div>

  <div class="grid gap-4 animate-fade-in-up-delay-1">
    {manifest.map((iface: any) => {
      const statusClass = iface.isDeprecated ? 'badge-deprecated' : iface.isStable ? 'badge-stable' : 'badge-draft';
      const statusText = iface.isDeprecated ? 'deprecated' : iface.isStable ? 'stable' : 'draft';

      return (
        <a href={`/docs/${iface.name}/`} class="glass rounded-2xl p-5 block group hover:border-accent/20 transition-all">
          <div class="flex items-center justify-between mb-2">
            <div class="flex items-center gap-3">
              <h2 class="text-lg font-semibold group-hover:text-accent transition-colors">{iface.name}</h2>
              <span class="text-xs font-mono text-text-muted">v{iface.version}</span>
              <span class:list={["text-[10px] px-2 py-0.5 rounded-full font-medium", statusClass]}>
                {statusText}
              </span>
            </div>
            <span class="text-xs text-text-muted">{iface.routes.length} route{iface.routes.length !== 1 ? 's' : ''}</span>
          </div>

          {iface.description && (
            <p class="text-sm text-text-secondary mb-3">{iface.description}</p>
          )}

          <div class="flex flex-wrap gap-2">
            {iface.routes.map((route: any) => {
              const methodClass = `method-${route.method.toLowerCase()}`;
              return (
                <span class:list={["inline-flex items-center gap-1.5 text-xs px-2 py-1 rounded-md border font-mono", methodClass]}>
                  <span class="font-semibold">{route.method}</span>
                  <span class="opacity-70">{route.path}</span>
                </span>
              );
            })}
          </div>
        </a>
      );
    })}
  </div>
</DocsLayout>
