---
import DocsLayout from '../../layouts/DocsLayout.astro';
import fullManifest from '../../data/api-manifest.json';
import CodeBlock from '../../components/CodeBlock.astro';
import { Gauge, Clock, Zap, Shield } from 'lucide-astro';

const rateLimits = fullManifest.rateLimits;

const rateLimitedResponse = `HTTP/1.1 429 Too Many Requests
Retry-After: 4
X-RateLimit-Remaining: 0

{
  "error": "rate_limited",
  "retry_after": 3.2,
  "message": "You are being rate limited."
}`;

const spaceRateLimitedResponse = `HTTP/1.1 429 Too Many Requests
Retry-After: 60

{
  "error": "space_rate_limited",
  "message": "The bots' budget for sticker and emoji changes in this space is spent for the minute; see Retry-After."
}`;
---

<DocsLayout title="Rate Limits — Argon Bot API" current="/guides/rate-limits/" toc={[
  { id: "how-it-works", title: "How It Works" },
  { id: "per-interface-limits", title: "Per-Interface Limits" },
  { id: "handling-429", title: "Handling 429 Responses" },
  { id: "space-budget", title: "Space Budget for Stickers & Emoji" },
  { id: "request-size", title: "Request Size" },
  { id: "verified-bot-limits", title: "Verified Bot Limits" },
]}>
  <div class="animate-fade-in-up">
    <h1 class="text-3xl font-bold tracking-tight mb-2">Rate Limits</h1>
    <p class="text-text-secondary text-lg">All Bot API requests are rate-limited per token using a sliding window algorithm. Stay within limits to avoid <code class="bg-oled-elevated px-1.5 py-0.5 rounded font-mono text-[13px]">429</code> responses.</p>
  </div>

  <div class="mt-10 space-y-12 animate-fade-in-up-delay-1">

    <!-- How it works -->
    <section>
      <div class="flex items-center gap-3 mb-4">
        <Gauge class="size-5 text-accent" />
        <h2 id="how-it-works" class="text-xl font-semibold">How It Works <a href="#how-it-works" class="anchor-link">#</a></h2>
      </div>

      <div class="space-y-4">
        <p class="text-text-secondary">
          Each bot token has a <strong class="text-text-primary">sliding window</strong> per interface.
          Each request consumes one permit. Permits replenish as the window slides forward in time.
        </p>

        <div class="glass rounded-2xl p-5 space-y-3">
          <div class="flex items-center gap-4">
            <Zap class="size-4 text-accent shrink-0" />
            <p class="text-sm text-text-secondary">
              <strong class="text-text-primary">Permit limit</strong> — maximum number of requests allowed within the
              sliding window. Smoothed across 6 segments for even distribution.
            </p>
          </div>
          <div class="flex items-center gap-4">
            <Clock class="size-4 text-accent shrink-0" />
            <p class="text-sm text-text-secondary">
              <strong class="text-text-primary">Window</strong> — the time period over which requests are counted.
              Permits become available as older segments slide out.
            </p>
          </div>
          <div class="flex items-center gap-4">
            <Shield class="size-4 text-accent shrink-0" />
            <p class="text-sm text-text-secondary">
              <strong class="text-text-primary">Concurrency</strong> — a global limit of <strong class="text-text-primary">10 concurrent requests</strong>
              per bot prevents parallel flooding, independent of per-interface limits.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Per-interface limits -->
    <section>
      <h2 id="per-interface-limits" class="text-xl font-semibold mb-4">Per-Interface Limits <a href="#per-interface-limits" class="anchor-link">#</a></h2>
      <p class="text-text-secondary mb-4">
        Each interface has its own sliding window. Limits are enforced independently per bot token.
      </p>

      <div class="glass rounded-2xl overflow-hidden">
        <div class="type-grid">
          <div class="type-grid-header" style="grid-template-columns: 1.5fr 1fr 1fr">
            <span>Interface</span>
            <span>Limit</span>
            <span>Window</span>
          </div>
          {rateLimits.map((r: any) => (
            <div class="type-grid-row" style="grid-template-columns: 1.5fr 1fr 1fr">
              <span class="font-mono text-[12px] text-accent">{r.interfaceName}</span>
              <span class="font-mono text-[12px] text-text-secondary">{r.permitLimit} req</span>
              <span class="font-mono text-[12px] text-text-secondary">{r.window}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Handling 429 -->
    <section>
      <h2 id="handling-429" class="text-xl font-semibold mb-4">Handling 429 Responses <a href="#handling-429" class="anchor-link">#</a></h2>
      <div class="space-y-3">
        <p class="text-text-secondary">
          When a bucket is empty, the server returns <code class="bg-oled-elevated px-1 py-0.5 rounded font-mono text-[11px]">429 Too Many Requests</code>.
        </p>

        <CodeBlock code={rateLimitedResponse} lang="http" />

        <div class="glass rounded-xl p-4">
          <p class="text-sm text-text-secondary">
            <strong class="text-text-primary">Check the <code class="bg-oled-elevated px-1 py-0.5 rounded font-mono text-[11px]">Retry-After</code> header</strong> —
            it tells you how many seconds to wait before retrying.
          </p>
        </div>
        <div class="glass rounded-xl p-4">
          <p class="text-sm text-text-secondary">
            <strong class="text-text-primary">Use exponential backoff</strong> —
            if you're consistently hitting limits, increase the delay between requests exponentially.
          </p>
        </div>
        <div class="glass rounded-xl p-4">
          <p class="text-sm text-text-secondary">
            <strong class="text-text-primary">Queue non-urgent work</strong> —
            batch operations when possible instead of sending many small requests.
          </p>
        </div>
      </div>
    </section>

    <!-- Space budget -->
    <section>
      <h2 id="space-budget" class="text-xl font-semibold mb-4">Space Budget for Stickers &amp; Emoji <a href="#space-budget" class="anchor-link">#</a></h2>
      <div class="space-y-3">
        <p class="text-text-secondary">
          Sticker and custom emoji work has a second limit on top of the <code class="bg-oled-elevated px-1 py-0.5 rounded font-mono text-[11px]">IExpressions</code> (60/min)
          and <code class="bg-oled-elevated px-1 py-0.5 rounded font-mono text-[11px]">IFiles</code> (30/min) windows above. Each space allows
          <strong class="text-text-primary">120 changes per minute from all bots together</strong> — a budget kept apart from the people's, so bots and members never starve each other.
          Past it, a change returns <code class="bg-oled-elevated px-1 py-0.5 rounded font-mono text-[11px]">429</code> with its own code:
        </p>

        <CodeBlock code={spaceRateLimitedResponse} lang="http" />

        <div class="type-grid">
          <div class="type-grid-header" style="grid-template-columns: 1fr 1.2fr 1.2fr">
            <span></span>
            <span>rate_limited</span>
            <span>space_rate_limited</span>
          </div>
          <div class="type-grid-row" style="grid-template-columns: 1fr 1.2fr 1.2fr">
            <span class="text-[12px] text-text-muted">Counts</span>
            <span class="text-[12px] text-text-secondary">Every request of one bot to one interface, in every space</span>
            <span class="text-[12px] text-text-secondary">Changes by every bot in one space</span>
          </div>
          <div class="type-grid-row" style="grid-template-columns: 1fr 1.2fr 1.2fr">
            <span class="text-[12px] text-text-muted">Window</span>
            <span class="text-[12px] text-text-secondary">Sliding, per the table above</span>
            <span class="text-[12px] text-text-secondary">Fixed: a minute from the first change; once spent, a minute from the first refusal</span>
          </div>
          <div class="type-grid-row" style="grid-template-columns: 1fr 1.2fr 1.2fr">
            <span class="text-[12px] text-text-muted">Retry-After</span>
            <span class="text-[12px] text-text-secondary">Seconds until a permit frees up</span>
            <span class="text-[12px] text-text-secondary">Always 60 — the budget is back at the latest a minute after the refusal</span>
          </div>
        </div>

        <div class="glass rounded-xl p-4">
          <p class="text-sm text-text-secondary">
            <strong class="text-text-primary">What counts as a change</strong> — <code class="bg-oled-elevated px-1 py-0.5 rounded font-mono text-[11px]">CreatePack</code>,
            <code class="bg-oled-elevated px-1 py-0.5 rounded font-mono text-[11px]">UpdatePack</code>, <code class="bg-oled-elevated px-1 py-0.5 rounded font-mono text-[11px]">AddItem</code> and
            <code class="bg-oled-elevated px-1 py-0.5 rounded font-mono text-[11px]">UpdateItem</code>. Reads never count, and neither do a repeated <code class="bg-oled-elevated px-1 py-0.5 rounded font-mono text-[11px]">CreatePack</code>
            that returns the bot's existing pack or an update that changes nothing. An <code class="bg-oled-elevated px-1 py-0.5 rounded font-mono text-[11px]">AddItem</code> refused for its file
            (<code class="bg-oled-elevated px-1 py-0.5 rounded font-mono text-[11px]">invalid_format</code>, <code class="bg-oled-elevated px-1 py-0.5 rounded font-mono text-[11px]">too_large</code>,
            <code class="bg-oled-elevated px-1 py-0.5 rounded font-mono text-[11px]">content_rejected</code>) has already counted. Branch on the <code class="bg-oled-elevated px-1 py-0.5 rounded font-mono text-[11px]">error</code>
            code, not the status: both limits answer <code class="bg-oled-elevated px-1 py-0.5 rounded font-mono text-[11px]">429</code>, and both are waited out the same way.
            See <a href="/guides/stickers-and-emoji/#errors" class="text-accent hover:underline">Stickers &amp; Custom Emoji</a>.
          </p>
        </div>
      </div>
    </section>

    <!-- Request size -->
    <section>
      <h2 id="request-size" class="text-xl font-semibold mb-4">Request Size <a href="#request-size" class="anchor-link">#</a></h2>
      <div class="space-y-3">
        <p class="text-text-secondary">
          Routes that take files also cap the body. Past the cap the server answers <code class="bg-oled-elevated px-1 py-0.5 rounded font-mono text-[11px]">413 too_large</code>.
        </p>

        <div class="type-grid">
          <div class="type-grid-header" style="grid-template-columns: 1.5fr 1fr 2fr">
            <span>Route</span>
            <span>Body</span>
            <span>Largest file</span>
          </div>
          <div class="type-grid-row" style="grid-template-columns: 1.5fr 1fr 2fr">
            <span class="font-mono text-[12px] text-accent">IFiles/Upload</span>
            <span class="font-mono text-[12px] text-text-secondary">≈ 10 MiB</span>
            <span class="text-[12px] text-text-secondary">10 MiB for an attachment; 4 MiB for a sticker or emoji file.</span>
          </div>
          <div class="type-grid-row" style="grid-template-columns: 1.5fr 1fr 2fr">
            <span class="font-mono text-[12px] text-accent">IMessages/Send</span>
            <span class="font-mono text-[12px] text-text-secondary">≈ 10 MiB</span>
            <span class="text-[12px] text-text-secondary">10 MiB; the parts of one multipart request share the body. Larger sets go through <code>IFiles/Upload</code> first.</span>
          </div>
          <div class="type-grid-row" style="grid-template-columns: 1.5fr 1fr 2fr">
            <span class="font-mono text-[12px] text-accent">IExpressions/AddItem</span>
            <span class="font-mono text-[12px] text-text-secondary">5 MiB</span>
            <span class="text-[12px] text-text-secondary">By format — see <a href="/guides/stickers-and-emoji/#formats" class="text-accent hover:underline">Formats &amp; Limits</a>.</span>
          </div>
        </div>

        <p class="text-sm text-text-muted">
          ≈ 10 MiB is 10 MiB of file plus 256 KiB for the form around it.
        </p>
      </div>
    </section>

    <!-- Verified bots -->
    <section>
      <h2 id="verified-bot-limits" class="text-xl font-semibold mb-4">Verified Bot Limits <a href="#verified-bot-limits" class="anchor-link">#</a></h2>
      <p class="text-text-secondary">
        <a href="/guides/glossary/#verified-bot" class="text-accent hover:underline">Verified bots</a> receive higher
        rate limits automatically. There is no separate API — once your bot is verified, limits are increased server-side.
      </p>
    </section>
  </div>
</DocsLayout>
